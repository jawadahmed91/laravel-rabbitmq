{
  "name": "jawadahmed91/laravel-rabbitmq",
  "description": "Focused RabbitMQ publishing examples for Laravel 13",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/support": "^13.0",
    "php-amqplib/php-amqplib": "^3.7"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {"psr-4": {"JawadAhmed\\LaravelRabbitMq\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["JawadAhmed\\LaravelRabbitMq\\RabbitMqServiceProvider"]}},
  "scripts": {"test": "phpunit"}
}
